{
  "type": "module",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">= 26"
  },
  "imports": {
    "#/*": "./*",
    "#database/*": "./database/*",
    "#generated/*": "./generated/*",
    "#resolvers/*": "./resolvers/*",
    "#staticData/*": "./staticData/*",
    "#utils/*": "./utils/*"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dumpSchema": "tsx ./utils/dump-schema.mts",
    "graphQlGen": "graphql-codegen --config codegen.yml",
    "prettier": "prettier --write './**/*.{mts,js,graphql}'",
    "start": "tsx index.mts",
    "startDev": "tsx --watch index.mts",
    "startDocker": "docker compose up --build -d",
    "prismaEmit": "prisma contract emit",
    "build:dist": "dotenv -e .env -- node ./tools/build-esbuild.mjs",
    "build": "dotenv -e .env -- sh -lc \"DOCKER_BUILDKIT=1 docker buildx build --platform linux/arm64 --no-cache --progress=plain --build-arg DATABASE_URL=\\\"$DATABASE_URL\\\" -t mattsarz78/graphql:latest .\"",
    "lint": "eslint .",
    "lintFix": "eslint . --fix",
    "dockerRun": "docker run --name gql -p 8020:8020 mattsarz78/graphql:latest",
    "tagImage": "docker tag mattsarz78/graphql:latest mattsarz78/graphql:latest",
    "pushImage": "docker push mattsarz78/graphql:latest",
    "pullImage": "docker pull mattsarz78/graphql:latest"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@dotenvx/dotenvx": "2.28.0",
    "@graphql-tools/graphql-file-loader": "8.1.20",
    "@graphql-tools/load": "8.1.17",
    "@graphql-tools/merge": "9.2.4",
    "@prisma/cli-engine": "0.3.0",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "body-parser": "2.3.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "express": "5.2.1",
    "graphql": "17.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.1",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-resolvers": "6.1.0",
    "@types/body-parser": "1.19.6",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.1",
    "dotenv-cli": "11.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "prisma": "8.0.0-rc.15",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0"
  },
  "graphql": {
    "schema": "./schema.graphql",
    "documents": "./**/*.{graphql,js,mts,jsx,tsx}"
  },
  "packageManager": "pnpm@12.4.2"
}
