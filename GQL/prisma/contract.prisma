// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace mattsarzsports {

model football {
  id             BigInt    @id @default(autoincrement())
  season         String?
  gametitle      String?
  visitingteam   String?
  hometeam       String?
  location       String?
  network        String?
  networkjpg     String?
  coveragenotes  String?
  ppv            String?
  time           DateTime? @default(dbgenerated("'9999-12-31 00:00:00'::timestamp without time zone"))
  week           Int?
  listorder      Int?
  mediaindicator String?   @default("N")
  conference     String?
  fcs            String?
  tvtype         String?
  timewithoffset DateTime? @default(dbgenerated("(\"time\" AT TIME ZONE 'US/Eastern'::text)"))

  @@index([conference], map: "idx_fb_conference")
  @@index([season, week], map: "idx_fb_season_week")
  @@index([hometeam, visitingteam], map: "idx_football_teams")
  @@index([mediaindicator, timewithoffset], map: "idx_fb_mi_timeoffset")
  @@map("football")
}

model basketball {
  id             BigInt    @id @default(autoincrement())
  season         String?
  gametitle      String?
  visitingteam   String?
  hometeam       String?
  location       String?
  network        String?
  networkjpg     String?
  coveragenotes  String?
  ppv            String?
  time           DateTime? @default(dbgenerated("'9999-12-31 00:00:00'::timestamp without time zone"))
  week           Int?
  listorder      Int?
  mediaindicator String?   @default("N")
  conference     String?
  fcs            String?
  tvtype         String?
  timewithoffset DateTime? @default(dbgenerated("(\"time\" AT TIME ZONE 'US/Eastern'::text)"))

  @@index([conference], map: "idx_mbb_conference")
  @@index([season, week], map: "idx_mbb_season_week")
  @@index([hometeam, visitingteam], map: "idx_basketball_teams")
  @@index([mediaindicator, timewithoffset], map: "idx_mbb_mi_timeoffset")
  @@map("basketball")
}

model availabletv {
  season     String
  conference String
  week       Int
  tvoptions  String?

  @@id([season, conference, week])
  @@map("availabletv")
}

model weeklydates {
  season        String
  week          Int
  startdate     String?
  enddate       String?
  postseasonind String?

  @@id([season, week])
  @@index([season], map: "idx_wkly_dates_season")
  @@map("weeklydates")  
}

model seasondata {
  season             String  @id
  hasPostseason      Boolean
  hasNoTVGames       Boolean
  showPPVColumn      Boolean
  conferenceListBase String?
  independents       String?
  flexScheduleLink   String?
  @@map("seasondata")  
}
} 